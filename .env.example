# Copy to .env next to the stack. Real values never go in git.
POUROVER_INBOUND_TOKEN=change-me-long-random-string
POUROVER_USERS_FILE=/config/users.yaml
POUROVER_DB=/data/pourover.db
POUROVER_TZ=Asia/Kolkata
POUROVER_QUEUE_EXPIRY_HOURS=6

VIKUNJA_URL=http://vikunja:3456
VIKUNJA_TOKEN_USER_A=placeholder
VIKUNJA_TOKEN_USER_B=placeholder

# llama-swap on roastery (OpenAI-compatible). Leave empty to run fast path + offline fallback only.
LLM_URL=http://roastery.lan:8080
LLM_MODEL=gemma-4-12b

NTFY_URL=https://ntfy.example.lan
NTFY_TOKEN_USER_A=placeholder
NTFY_TOKEN_USER_B=placeholder

# meowGram bot (Release 2 bot API). Leave MEOWGRAM_URL empty to run without it.
MEOWGRAM_URL=http://meowgram-server:8080
MEOWGRAM_BOT_USER=pourover-bot
MEOWGRAM_BOT_PASSWORD=placeholder
# A dedicated channel for pourOver; empty = the shared lounge.
MEOWGRAM_CHANNEL=
# Messages must start with this to reach pourOver. Empty = every message (only sensible in its own channel).
MEOWGRAM_TRIGGER=@pourover
MEOWGRAM_POLL_S=3
